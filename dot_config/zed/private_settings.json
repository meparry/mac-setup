// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "session": {
    "trust_all_worktrees": false
  },
  "context_servers": {
    "chrome-devtools": {
      "enabled": true,
      "remote": false,
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--channel=beta"
      ]
    }
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "xhigh",
        "mode": "full-access"
      },
      "favorite_config_option_values": {
        "mode": [
          "full-access"
        ]
      },
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry",
      "default_mode": "bypassPermissions",
      "default_config_options": {
        "mode": "bypassPermissions",
      },
    },
  },
  "toolbar": {
    "quick_actions": false,
    "breadcrumbs": false,
    "selections_menu": false,
  },
  "scrollbar": {
    "diagnostics": "none",
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": false,
    "show": true,
    "show_nav_history_buttons": false,
  },
  "tabs": {
    "file_icons": false,
  },
  "outline_panel": {
    "dock": "left",
    "indent_guides": {
      "show": "never",
    },
  },
  "project_panel": {
    "dock": "left",
    "indent_guides": {
      "show": "never",
    },
  },
  "show_wrap_guides": true,
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
    },
    "model_parameters": [],
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "base_keymap": "Cursor",
  "vim_mode": true,
  "ui_font_size": 15,
  "buffer_font_size": 12,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Dark",
  },
  "indent_guides": {
    "enabled": false,
  },
  "gutter": {
    "line_numbers": false,
  },
  "git": {
    "git_gutter": "hide",
    "inline_blame": {
      "enabled": false,
    },
  },
}
